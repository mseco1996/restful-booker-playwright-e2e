# Copy this file to .env for local runs:  cp .env.example .env
# .env is git-ignored. In CI, set these as GitHub Actions variables (non-secret) and secrets.
# A blank value (KEY=) is treated as "not set".

# ---------------------------------------------------------------------------
# Target environment
# ---------------------------------------------------------------------------
# public-demo = https://automationintesting.online (shared, resets every 10 min, 2 workers max)
# local       = your own Docker instance of restful-booker-platform
TARGET_ENV=public-demo
BASE_URL=https://automationintesting.online

# Optional. Defaults to ${BASE_URL}/api. Override only if your local stack serves the API elsewhere.
API_BASE_URL=

# ---------------------------------------------------------------------------
# Admin credentials
# ---------------------------------------------------------------------------
# These are the public demo's published defaults. In CI they come from GitHub secrets.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password

# ---------------------------------------------------------------------------
# Execution (optional)
# ---------------------------------------------------------------------------
# Number of parallel workers. Default: 2 on public-demo, Playwright's default otherwise.
WORKERS=
# Prefix for test data created by this run. Default: gh-<run>-<attempt> in CI, local-<timestamp> locally.
RUN_ID=

# ---------------------------------------------------------------------------
# Xray Cloud (only needed by the result upload script, not to run tests)
# ---------------------------------------------------------------------------
# Regional instances use e.g. https://eu.xray.cloud.getxray.app
XRAY_BASE_URL=https://xray.cloud.getxray.app
XRAY_CLIENT_ID=
XRAY_CLIENT_SECRET=
XRAY_PROJECT_KEY=RBP
XRAY_TEST_PLAN_KEY=
